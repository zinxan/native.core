{
    "name": "zinxan/native-core",
    "description": "The shared NativeWatch client that zinxan/native-desktop and zinxan/native-mobile build on.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/process": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "ZXN\\NativeWatch\\Core\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "homepage": "https://native.watch",
    "support": {
        "docs": "https://native.watch/docs",
        "issues": "https://github.com/zinxan/native.core/issues",
        "source": "https://github.com/zinxan/native.core"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.8|^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0|^5.0",
        "pestphp/pest-plugin-type-coverage": "^3.0|^4.0|^5.0",
        "zinxan/native-desktop": "^0.2"
    },
    "autoload-dev": {
        "psr-4": {
            "ZXN\\NativeWatch\\Core\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ],
        "test:lint": "pint --test",
        "test:types": "phpstan analyse --memory-limit=1G",
        "test:unit": "pest --compact",
        "test:type-coverage": "pest --type-coverage --min=100"
    }
}
